{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Calendar Week Ahead",
  "description": "7-day week agenda view showing events from Nango-connected calendars. Each calendar gets its own color accent. Supports dark/light themes and multiple layouts (featured, agenda, weekstrip).",
  "properties": {
    "theme": {
      "type": "string",
      "title": "Theme",
      "description": "Visual theme for the calendar display",
      "enum": ["dark", "light"],
      "default": "dark"
    },
    "layout": {
      "type": "string",
      "title": "Layout",
      "description": "Layout style for the calendar view",
      "enum": ["featured", "agenda", "weekstrip"],
      "default": "featured"
    },
    "nango_base_url": {
      "type": "string",
      "title": "Nango Base URL",
      "description": "Nango API base URL for calendar proxy",
      "default": "https://nango.example.com"
    },
    "nango_secret_key": {
      "type": "string",
      "title": "Nango Secret Key",
      "description": "Nango API secret key",
      "ui:widget": "password"
    },

    "calendar_1_connection_id": { "type": "string", "enum": ["", "REDACTED-CONNECTION", "REDACTED-CONNECTION", "REDACTED-CONNECTION", "REDACTED-UUID", "REDACTED-CONNECTION", "REDACTED-UUID", "REDACTED-UUID"], "default": "" },
    "calendar_1_calendar_id": { "type": "string", "default": "" },
    "calendar_1_label": { "type": "string", "default": "" },
    "calendar_1_color": { "type": "string", "enum": ["blue", "red", "green", "yellow", "orange", "black"], "default": "blue" },
    "calendar_1_color_custom": { "type": "string", "default": "" },

    "calendar_2_connection_id": { "type": "string", "enum": ["", "REDACTED-CONNECTION", "REDACTED-CONNECTION", "REDACTED-CONNECTION", "REDACTED-UUID", "REDACTED-CONNECTION", "REDACTED-UUID", "REDACTED-UUID"], "default": "" },
