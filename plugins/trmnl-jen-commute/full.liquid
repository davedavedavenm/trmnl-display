{% assign theme_mode = trmnl.plugin_settings.custom_fields_values.theme | default: 'dark' %}
{% assign show_map_link = trmnl.plugin_settings.custom_fields_values.show_map_link | default: true %}
{% assign show_home_prep = trmnl.plugin_settings.custom_fields_values.show_home_prep | default: true %}
{% assign screen_label = trmnl.plugin_settings.custom_fields_values.screen_label | default: 'Jen Commute' %}
{% assign commute_state_display = commute_state | default: 'idle' | replace: '_', ' ' %}
{% assign heading_home_display = heading_home | default: 'No' %}

{% assign bg = '#000000' %}
{% assign fg = '#FFFFFF' %}
{% assign gold = '#968327' %}
{% assign olive = '#59683F' %}
{% assign navy = '#28487B' %}
{% assign brown = '#52180A' %}
{% assign dim = '#555555' %}

{% assign eta_num = eta_minutes | default: 0 | plus: 0 %}
{% if eta_num <= 10 %}
  {% assign accent = olive %}
  {% assign urgency = 'ALMOST HERE' %}
{% elsif eta_num <= 25 %}
  {% assign accent = gold %}
  {% assign urgency = 'EN ROUTE' %}
{% elsif eta_num <= 45 %}
  {% assign accent = gold %}
  {% assign urgency = 'COMMUTING' %}
{% else %}
  {% assign accent = brown %}
  {% assign urgency = 'HEADING OUT' %}
{% endif %}

{% if heading_home == 'Yes' %}
  {% assign dir = '←' %}
{% else %}
  {% assign dir = '→' %}
{% endif %}

<div style="width:800px; height:480px; background:{{ bg }}; color:{{ fg }}; font-family: 'Segoe UI', system-ui, sans-serif; display:flex; flex-direction:column;">

  <!-- TOP BAR -->
  <div style="display:flex; justify-content:space-between; align-items:baseline; padding:16px 32px 12px; border-bottom:3px solid {{ accent }};">
    <div style="display:flex; align-items:baseline; gap:16px;">
      <span style="font-size:14px; font-weight:900; letter-spacing:0.3em; text-transform:uppercase; color:{{ accent }};">{{ screen_label }}</span>
      <span style="font-size:14px; font-weight:800; letter-spacing:0.15em; color:{{ fg }};">{{ urgency }}</span>
    </div>
    <span style="font-size:14px; font-weight:700; color:{{ dim }}; letter-spacing:0.05em;">{{ updated_at }}</span>
  </div>

  <!-- MAIN: 2-column asymmetric -->
  <div style="flex:1; display:grid; grid-template-columns: 1fr 300px;">

    <!-- LEFT: Headline + ETA -->
    <div style="padding:24px 32px; display:flex; flex-direction:column; justify-content:center; gap:20px;">

      <!-- Big headline -->
      <div style="font-size:48px; font-weight:900; line-height:1.05; letter-spacing:-0.02em; color:{{ fg }};">
        {{ headline | default: 'Heading Out' }}
      </div>

      <!-- State + Direction -->
      <div style="display:flex; align-items:center; gap:20px;">
        <div style="font-size:20px; font-weight:800; color:{{ dim }}; letter-spacing:0.08em; text-transform:uppercase;">{{ commute_state_display }}</div>
        <div style="width:2px; height:20px; background:{{ dim }};"></div>
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:28px; font-weight:900; color:{{ olive }};">{{ dir }}</span>
          <span style="font-size:20px; font-weight:800; color:{{ fg }};">Home: {{ heading_home_display }}</span>
        </div>
      </div>

      <!-- ETA row -->
      <div style="display:flex; align-items:baseline; gap:24px; margin-top:8px;">
        <span style="font-size:120px; font-weight:900; line-height:0.75; letter-spacing:-0.05em; color:{{ accent }};">{{ eta_minutes | default: '—' }}</span>
        <div>
          <div style="font-size:18px; font-weight:800; letter-spacing:0.2em; text-transform:uppercase; color:{{ dim }};">minutes</div>
          <div style="font-size:16px; font-weight:700; color:{{ dim }}; margin-top:4px;">away</div>
        </div>
      </div>

    </div>

    <!-- RIGHT: Route + Home Prep -->
    <div style="padding:24px 24px 24px 0; display:flex; flex-direction:column; gap:16px; border-left:3px solid {{ bg }};">

      <!-- Route -->
      <div style="background:{{ navy }}; border-radius:16px; padding:20px 22px; flex:1;">
        <div style="font-size:12px; font-weight:900; letter-spacing:0.25em; text-transform:uppercase; color:{{ fg }}; opacity:0.7;">Route</div>
        <div style="font-size:26px; font-weight:900; margin:8px 0 4px; color:{{ fg }};">{{ route_label | default: 'Direct' }}</div>
        <div style="font-size:16px; font-weight:700; color:{{ fg }}; opacity:0.6;">
          {% if distance_km and distance_km != '?' and distance_km != '' %}
            {{ distance_km }} km
          {% else %}
            —
          {% endif %}
        </div>
      </div>

      {% if show_home_prep == true or show_home_prep == 'true' %}
      <!-- Home Prep -->
      <div style="background:{{ olive }}; border-radius:16px; padding:20px 22px; flex:1;">
        <div style="font-size:12px; font-weight:900; letter-spacing:0.25em; text-transform:uppercase; color:{{ fg }}; opacity:0.7;">Home Prep</div>
        <div style="font-size:24px; font-weight:900; margin:8px 0 4px; color:{{ fg }};">{{ home_prep_status }}</div>
        {% if prep_note %}
        <div style="font-size:14px; font-weight:600; color:{{ fg }}; opacity:0.6; line-height:1.3;">{{ prep_note }}</div>
        {% endif %}
      </div>
      {% endif %}

      <!-- Bottom row -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
        {% assign map_enabled = false %}
        {% if show_map_link == true or show_map_link == 'true' %}
          {% assign map_enabled = true %}
        {% endif %}
        {% if map_enabled and map_url %}
        <div style="background:{{ gold }}; border-radius:12px; padding:14px 16px;">
          <div style="font-size:11px; font-weight:900; letter-spacing:0.2em; text-transform:uppercase; color:{{ bg }};">Map</div>
          <div style="font-size:14px; font-weight:800; color:{{ bg }}; margin-top:2px;">Ready</div>
        </div>
        {% endif %}
        <div style="background:{{ brown }}; border-radius:12px; padding:14px 16px;">
          <div style="font-size:11px; font-weight:900; letter-spacing:0.2em; text-transform:uppercase; color:{{ fg }}; opacity:0.7;">Status</div>
          <div style="font-size:14px; font-weight:800; color:{{ fg }}; margin-top:2px;">{{ commute_state_display | truncate: 14 }}</div>
        </div>
      </div>

    </div>
  </div>
</div>
